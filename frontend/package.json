{
  "name": "frontend",
  "private": true,
  "version": "0.8.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "npm run check:i18n && npm run generate:i18n",
    "dev": "vite",
    "build": "npm run check:i18n && npm run generate:i18n && npm run generate:routes && tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "check:i18n": "node ./scripts/check-i18n-messages.mjs",
    "generate:notices": "node ../scripts/generate-frontend-third-party-notices.mjs",
    "generate:i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy localStorage cookie preferredLanguage baseLocale --emit-ts-declarations --silent",
    "generate:routes": "tsr generate"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@inlang/paraglide-js": "^2.24.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.102.2",
    "@tanstack/react-router": "^1.170.32",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "1.167.33",
    "@tanstack/router-plugin": "^1.168.35",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
