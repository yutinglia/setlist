# Optional absolute API origin (no trailing slash).
# Leave unset in local `npm run dev` — Vite proxies `/v1` → http://127.0.0.1:8000
# VITE_API_BASE_URL=http://localhost:8000

# Absolute public origin used for Open Graph image metadata.
# VITE_PUBLIC_SITE_URL=https://setlist.example.com

# Public source/contact destination used on About and copyright pages.
# VITE_SOURCE_URL=https://github.com/yutinglia/vtuber-karaoke-search
