# Optional absolute API origin (no trailing slash).
# Leave unset in local `npm run dev` — Vite proxies `/v1` → http://127.0.0.1:8000
# VITE_API_BASE_URL=http://localhost:8000

# Production builds hide mutation/scraper controls unless explicitly enabled.
# The backend must also set MANAGEMENT_API_ENABLED=true.
# VITE_MANAGEMENT_UI_ENABLED=false
