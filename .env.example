# Copy to .env and adjust. Do not commit a real .env.

# Production frontend bind (loopback for a host reverse proxy) and Docker subnet.
FRONTEND_PORT=8080
VKS_SUBNET=172.30.0.0/24
# VITE_SOURCE_URL=https://github.com/yutinglia/setlist
# Guest channel-request contact: http(s), mailto:, or a same-origin /path.
# Defaults to the channel-request issue form under VITE_SOURCE_URL when unset.
# VITE_CHANNEL_REQUEST_URL=https://github.com/yutinglia/setlist/issues/new?template=channel-request.yml

# App environment: dev | prod | test
# dev enables /docs and local CORS origins
APP_ENV=dev

# Opt-in in every environment. Production Compose explicitly defaults this to true.
BACKGROUND_UPDATER_ENABLED=false

# Emergency kill switch for authenticated administrator mutations.
# Authentication is always required even when this is true.
MANAGEMENT_API_ENABLED=true

# Administrator authentication. Generate the hash interactively with:
#   cd backend
#   python generate_admin_password_hash.py
# Generate SESSION_SECRET with a password manager or:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Store the real values only in the ignored .env file / deployment secret store.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=43200
# Set true whenever the public site is served over HTTPS (required in prod).
AUTH_COOKIE_SECURE=false

# Anonymous per-IP limits. The stricter login limit replaces the general limit
# for POST /v1/auth/login.
GUEST_RATE_LIMIT_ENABLED=true
GUEST_RATE_LIMIT_REQUESTS=60
GUEST_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_REQUESTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Persisted pause between administrator channel-resolution requests and
# between entries in a bulk add (maximum 10 entries).
CHANNEL_ADD_COOLDOWN_SECONDS=10

# Trust X-Forwarded-For only from these reverse-proxy networks. Production
# Compose defaults this to its VKS_SUBNET for the bundled frontend proxy.
# TRUSTED_PROXY_CIDRS=172.16.0.0/12,192.168.1.10/32

# Comma-separated browser origins for credentialed CORS.
# Example: https://example.com,http://localhost:3000
# Same-origin deployments can leave this empty.
# CORS_ORIGINS=

# Database (inside Compose / Dev Container, use DB_HOST=db)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vks_db
DB_USER=vks_db_user
DB_PASSWORD=replace-with-a-random-local-password

# Optional: full URL overrides DB_* above
# DATABASE_URL=postgresql+asyncpg://vks_db_user:vks_db_pwd@localhost:5432/vks_db

# Worker heartbeat. Defaults are identical in dev/prod; a tick only performs
# persisted work that is due. Use `python run_updater_once.py` for local testing.
DATA_UPDATE_INTERVAL=300

# Steady-state discovery: each channel is checked at most every six hours.
UPDATE_STEADY_SCAN_INTERVAL=21600
UPDATE_STEADY_RETRY_BASE=900
UPDATE_STEADY_CHANNELS_PER_CYCLE=3
UPDATE_MAX_VIDEOS=40
# Per-video metadata requests during a manual safe refresh
UPDATE_MAX_METADATA_SCRAPES=10

# Fast flat-playlist backfill, with a durable cursor after every page.
UPDATE_BACKFILL_PAGE_SIZE=100
UPDATE_BACKFILL_PAGES_PER_CYCLE=3
UPDATE_BACKFILL_CHANNELS_PER_CYCLE=1
UPDATE_LIST_SLEEP_MIN=3
UPDATE_LIST_SLEEP_MAX=7
YTDLP_LIST_SLEEP_INTERVAL=1
YTDLP_LIST_MAX_SLEEP_INTERVAL=2

# Comment analysis is intentionally slower/more conservative than discovery.
UPDATE_MAX_COMMENT_SCRAPES=3
UPDATE_SCRAPE_SLEEP_MIN=20
UPDATE_SCRAPE_SLEEP_MAX=40
UPDATE_YOUTUBE_COOLDOWN_SECONDS=21600
UPDATE_MAX_ANALYZE_ATTEMPTS=5
UPDATE_ANALYSIS_RECHECK_SECONDS=86400
UPDATE_ANALYSIS_RETRY_BASE=1800
# First pass stays cheap; later attempts search deeper for lower-ranked setlists.
UPDATE_MAX_COMMENTS_PER_VIDEO=50
UPDATE_MAX_RECHECK_COMMENTS_PER_VIDEO=200

# yt-dlp sleeps for comment scrapes (raised vs channel/video list scrapers)
YTDLP_COMMENT_SLEEP_INTERVAL=2
YTDLP_COMMENT_MAX_SLEEP_INTERVAL=10

# Bound individual network retries and the complete blocking scraper operation.
# Production runs each yt-dlp operation in a killable child process.
YTDLP_SOCKET_TIMEOUT_SECONDS=30
YTDLP_RETRIES=2
YTDLP_EXTRACTOR_RETRIES=2
YTDLP_OPERATION_TIMEOUT_SECONDS=300
YTDLP_TERMINATE_GRACE_SECONDS=5

# Allow Docker to cancel the worker cleanly. Durable heartbeats make a crashed
# or wedged cycle visible to the administrator status page after 120 seconds.
UPDATER_SHUTDOWN_GRACE_SECONDS=20
UPDATER_HEARTBEAT_INTERVAL_SECONDS=30
UPDATER_HEARTBEAT_STALE_SECONDS=120

# Optional shared response cache. Leave CACHE_URL empty for the no-op adapter.
# The bundled Valkey service is opt-in:
#   CACHE_URL=redis://cache:6379/0 docker compose --profile cache up -d
# The same URL format works with an externally managed Redis or Valkey.
CACHE_URL=
CACHE_KEY_PREFIX=setlist
CACHE_DEFAULT_TTL_SECONDS=900
CACHE_SEARCH_TTL_SECONDS=900
CACHE_CATALOG_TTL_SECONDS=3600
CACHE_REPORT_TTL_SECONDS=300
CACHE_FAILURE_BACKOFF_SECONDS=5
CACHE_CONNECT_TIMEOUT_SECONDS=1
CACHE_SOCKET_TIMEOUT_SECONDS=1
# Bundled Valkey memory policy. Keep maxmemory below the 128 MiB container
# limit so allocator overhead, fragmentation, and client buffers have headroom.
CACHE_MAXMEMORY=80mb
CACHE_MAXMEMORY_POLICY=allkeys-lru
CACHE_MAXMEMORY_CLIENTS=5%

# Phase 5 — optional LLM setlist cleaning (off by default; regex is primary)
# LLM_CLEANING_ENABLED=false
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_CLEANING_ATTEMPTS=2
# LLM_MAX_INPUT_CHARS=20000
