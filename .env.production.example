# Copy to .env for the production Compose stack. Replace every required blank.
# This file contains no credentials and is safe to commit; the resulting .env is not.

APP_ENV=prod
BACKGROUND_UPDATER_ENABLED=true
MANAGEMENT_API_ENABLED=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=43200
AUTH_COOKIE_SECURE=true

GUEST_RATE_LIMIT_ENABLED=true
GUEST_RATE_LIMIT_REQUESTS=60
GUEST_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_REQUESTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# The bundled frontend proxy lives on VKS_SUBNET, which production Compose
# trusts by default. Add another CIDR only if a separate trusted proxy connects
# directly to the API.
VKS_SUBNET=172.30.0.0/24
# TRUSTED_PROXY_CIDRS=172.30.0.0/24
# Keep loopback when the reverse proxy is on this host. For a reverse proxy on
# another trusted LAN host, bind only this server's private interface.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
PUBLIC_SITE_URL=

# Optional build override; local Compose reads the tracked VERSION file when
# this is empty. Release images receive a traceable version during publication.
# APP_VERSION=

# Same-origin frontend/API needs no CORS origins.
CORS_ORIGINS=
VITE_SOURCE_URL=https://github.com/yutinglia/setlist

DB_NAME=vks_db
DB_USER=vks_db_user
DB_PASSWORD=

# Blocking yt-dlp calls have both network-level and whole-operation deadlines.
YTDLP_SOCKET_TIMEOUT_SECONDS=30
YTDLP_RETRIES=2
YTDLP_EXTRACTOR_RETRIES=2
YTDLP_OPERATION_TIMEOUT_SECONDS=300
YTDLP_TERMINATE_GRACE_SECONDS=5
UPDATER_SHUTDOWN_GRACE_SECONDS=20
UPDATER_HEARTBEAT_INTERVAL_SECONDS=30
UPDATER_HEARTBEAT_STALE_SECONDS=120

# Optional OpenAI-compatible cleaning remains disabled unless explicitly set.
LLM_CLEANING_ENABLED=false
