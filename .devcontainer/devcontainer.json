{
  "name": "vtuber-karaoke-search",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": {
      "label": "FastAPI",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Vite",
      "onAutoForward": "notify"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22",
      "installYarnUsingApt": false
    }
  },
  "remoteEnv": {
    "APP_ENV": "dev",
    "DB_HOST": "db",
    "DB_PORT": "5432",
    "DB_NAME": "vks_db",
    "DB_USER": "vks_db_user",
    "DB_PASSWORD": "vks_db_pwd",
    "DATABASE_URL": "postgresql+asyncpg://vks_db_user:vks_db_pwd@db:5432/vks_db"
  },
  "postCreateCommand": "pip install -r data_updater/requirements.txt && npm --prefix frontend install",
  "postStartCommand": "bash .devcontainer/ensure-dev-servers.sh",
  "overrideCommand": false,
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "ms-azuretools.vscode-containers"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.extraPaths": ["/workspace/data_updater"],
        "terminal.integrated.cwd": "/workspace"
      }
    }
  }
}
